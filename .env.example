# Public Supabase connection settings; replace with your project's values.
# Never put service-role keys, database passwords, or private AI keys here.
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_URL="https://your-project-ref.supabase.co"

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Server-only NVIDIA NIM key (https://build.nvidia.com/settings/api-keys). Set it in
# .env locally and in your host's secret settings; never prefix it with VITE_.
NVIDIA_API_KEY="nvapi-your-key"
# Optional model override (default: nvidia/nemotron-3.5-lightning-30b-a3b)
# NVIDIA_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
