# Use a dedicated Supabase TEST project. These variables are not loaded
# automatically: export them in your shell before running test:integration.
RUN_DATABASE_TESTS=1
TEST_SUPABASE_URL=https://your-test-project.supabase.co
TEST_SUPABASE_PUBLISHABLE_KEY=your-test-publishable-key
TEST_OWNER_TOKEN=owner-test-user-access-token
TEST_OUTSIDER_TOKEN=nonmember-test-user-access-token
TEST_PRIVATE_TEAM_ID=private-test-team-uuid
